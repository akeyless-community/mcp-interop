# See docs/DEPLOY-AWS.md for public HTTPS hosting.
# Copy to /etc/akeyless-openid-mcp-interop.env on the server (do not commit real secrets).

INTEROP_HTTP_HOST=127.0.0.1
INTEROP_HTTP_PORT=8790
INTEROP_HTTP_PATH=/mcp

# --- Local lab (default) ---
INTEROP_RESOURCE=http://127.0.0.1:8790/mcp
INTEROP_PUBLIC_BASE_URL=http://127.0.0.1:8790
INTEROP_AUTHORIZATION_SERVERS=https://auth.example.com
INTEROP_JWT_ISSUER=https://auth.example.com
INTEROP_JWT_AUDIENCE=http://127.0.0.1:8790/mcp
INTEROP_SCOPES=mcp:tools
INTEROP_JWT_SECRET=local-demo-secret

# --- Partner / public HTTPS (replace YOUR_DNS and partner AS; unset JWT_SECRET) ---
# INTEROP_RESOURCE=https://YOUR_DNS/mcp
# INTEROP_PUBLIC_BASE_URL=https://YOUR_DNS
# INTEROP_RESOURCE_METADATA_URL=https://YOUR_DNS/.well-known/oauth-protected-resource
# INTEROP_AUTHORIZATION_SERVERS=https://partner-as.example.com
# INTEROP_JWT_ISSUER=https://partner-as.example.com
# INTEROP_JWT_AUDIENCE=https://YOUR_DNS/mcp
# INTEROP_JWKS_URI=https://partner-as.example.com/.well-known/jwks.json
# INTEROP_JWT_SECRET=
